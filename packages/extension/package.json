{
  "name": "@kitestring/extension",
  "displayName": "Kitestring",
  "version": "0.1.0",
  "description": "Lets AI agents control your real Chrome via the Kitestring CLI",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "pretest": "pnpm --filter @kitestring/protocol build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kitestring/page-agent": "workspace:*",
    "@kitestring/protocol": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "plasmo": "0.90.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "manifest": {
    "key": "",
    "permissions": [
      "debugger",
      "tabs",
      "tabGroups",
      "scripting",
      "nativeMessaging",
      "storage",
      "sidePanel",
      "notifications",
      "idle"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  }
}
